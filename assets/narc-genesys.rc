      VALUE "ProductName", "NARC Genesys"
      VALUE "ProductVersion", "5.1"
      VALUE "Comments", "UCI chess engine with NNUE evaluation. Country: Sri Lanka."
    END
  END
  BLOCK "VarFileInfo"
